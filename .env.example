# 本地开发环境变量示例。
#
# 用法：复制为 .env（已被 .gitignore 忽略），或直接 source 本文件。
#   cp .env.example .env
#   set -a && . ./.env && set +a
#
# 生产环境不读这个文件——K8s 下所有变量由 ConfigMap + Secret 通过 envFrom 注入，
# 见 deploy/k8s/00-configmap.yaml 与 01-secret.example.yaml。
# 两边变量名必须保持一致，否则会出现"本地能跑、集群起不来"。

# ---------- 应用 ----------
APP_ENV=dev
SERVER_PORT=8080
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=15s

# ---------- MySQL ----------
# 本地调试可临时用 SSH 隧道把集群 MySQL 映射到本地端口：
#   kubectl port-forward -n infra svc/mysql 13306:3306
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=yulin
MYSQL_USER=yulin
MYSQL_PASSWORD=changeme
MYSQL_PARAMS=charset=utf8mb4&parseTime=True&loc=Local&timeout=5s
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=1h

# ---------- Redis ----------
#   kubectl port-forward -n infra svc/redis 16379:6379
REDIS_ADDR=127.0.0.1:16379
REDIS_PASSWORD=changeme
REDIS_DB=1
REDIS_KEY_PREFIX=yulin:
REDIS_POOL_SIZE=10
